{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:behaviorlock:schema:profile:2.0.0",
  "title": "BehaviorLock npm install profile",
  "type": "object",
  "required": ["schemaVersion", "kind", "tool", "subject", "capture", "result", "behaviors"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "kind": { "const": "npm.install.profile" },
    "tool": { "$ref": "#/$defs/tool" },
    "subject": { "$ref": "#/$defs/subject" },
    "capture": { "$ref": "#/$defs/capture" },
    "result": { "$ref": "#/$defs/result" },
    "behaviors": {
      "type": "array",
      "maxItems": 250000,
      "items": { "$ref": "#/$defs/behavior" }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "status": { "enum": ["complete", "command_failed"] }
            }
          }
        }
      },
      "then": {
        "properties": {
          "capture": { "required": ["evidenceArtifact"] },
          "behaviors": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "status": { "enum": ["complete", "command_failed"] }
            }
          },
          "capture": {
            "properties": {
              "traceIntegrity": { "const": "isolated-root-tracer" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "subject": { "required": ["registryIntegrity", "dependencyLockSha256"] },
          "capture": { "required": ["runnerImage", "runnerImageId", "architecture", "nodeVersion", "npmVersion", "straceVersion"] }
        }
      }
    }
  ],
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "behaviorlock" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["ecosystem", "name", "version", "purl"],
      "properties": {
        "ecosystem": { "const": "npm" },
        "name": { "type": "string", "minLength": 1, "maxLength": 214 },
        "version": { "type": "string", "minLength": 5, "maxLength": 128 },
        "purl": { "type": "string", "pattern": "^pkg:npm/", "maxLength": 512 },
        "registryIntegrity": { "type": "string", "pattern": "^sha512-", "maxLength": 256 },
        "tarballSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "dependencyLockSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["scope", "lifecycle", "completeness", "limitations"],
      "properties": {
        "scope": { "enum": ["registry-install-lifecycle", "external-strace"] },
        "lifecycle": {
          "type": "array",
          "items": { "enum": ["preinstall", "install", "postinstall"] },
          "uniqueItems": true
        },
        "completeness": { "enum": ["partial", "unverified"] },
        "limitations": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      },
      "additionalProperties": false
    },
    "evidenceArtifact": {
      "type": "object",
      "required": ["sha256", "byteSize", "mediaType", "format", "retention", "envelope"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "byteSize": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "mediaType": { "const": "application/vnd.behaviorlock.strace" },
        "format": { "const": "strace-lines-v1" },
        "retention": { "enum": ["retained", "external-unverified"] },
        "envelope": { "enum": ["behaviorlock-trace-v1-payload", "external-strace"] }
      },
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "required": ["networkMode", "sandboxProfile", "traceIntegrity", "attestation", "coverage", "experimental"],
      "properties": {
        "runnerImage": { "type": "string", "minLength": 1, "maxLength": 256 },
        "runnerImageId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "architecture": { "type": "string", "minLength": 1, "maxLength": 64 },
        "nodeVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "npmVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "straceVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "networkMode": { "enum": ["none", "unknown"] },
        "sandboxProfile": { "type": "string", "minLength": 1, "maxLength": 128 },
        "traceIntegrity": { "enum": ["isolated-root-tracer", "external-unverified"] },
        "attestation": { "const": "none" },
        "durationMillis": { "type": "integer", "minimum": 0 },
        "coverage": { "$ref": "#/$defs/coverage" },
        "evidenceArtifact": { "$ref": "#/$defs/evidenceArtifact" },
        "experimental": { "const": true }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "traceIntegrity": { "const": "isolated-root-tracer" } } },
          "then": {
            "properties": {
              "networkMode": { "const": "none" },
              "sandboxProfile": { "const": "behaviorlock-linux-npm-v1" },
              "coverage": {
                "properties": {
                  "scope": { "const": "registry-install-lifecycle" },
                  "lifecycle": { "minItems": 3, "maxItems": 3 },
                  "completeness": { "const": "partial" }
                }
              },
              "evidenceArtifact": {
                "properties": {
                  "retention": { "const": "retained" },
                  "envelope": { "const": "behaviorlock-trace-v1-payload" }
                }
              }
            }
          },
          "else": {
            "properties": {
              "networkMode": { "const": "unknown" },
              "sandboxProfile": { "const": "external-unverified" },
              "coverage": {
                "properties": {
                  "scope": { "const": "external-strace" },
                  "lifecycle": { "maxItems": 0 },
                  "completeness": { "const": "unverified" }
                }
              },
              "evidenceArtifact": {
                "properties": {
                  "retention": { "const": "external-unverified" },
                  "envelope": { "const": "external-strace" }
                }
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "required": ["status", "exitCode", "timedOut", "truncated"],
      "properties": {
        "status": { "enum": ["complete", "command_failed", "timed_out", "trace_incomplete", "resource_exhausted"] },
        "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
        "timedOut": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "message": { "type": "string", "maxLength": 4096 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "complete" } } },
          "then": {
            "properties": {
              "timedOut": { "const": false },
              "truncated": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "timed_out" } } },
          "then": { "properties": { "timedOut": { "const": true } } }
        }
      ]
    },
    "evidenceRef": {
      "type": "object",
      "required": ["artifactSha256", "line", "lineSha256"],
      "properties": {
        "artifactSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "line": { "type": "integer", "minimum": 1 },
        "lineSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "behavior": {
      "type": "object",
      "required": ["type", "operation", "target", "outcome", "count", "id", "evidence", "sourceSyscall"],
      "properties": {
        "type": {
          "enum": [
            "filesystem.read",
            "filesystem.write",
            "filesystem.create",
            "filesystem.delete",
            "filesystem.rename",
            "filesystem.permission",
            "process.exec",
            "network.connect"
          ]
        },
        "operation": { "type": "string", "minLength": 1, "maxLength": 64 },
        "target": { "type": "string", "maxLength": 4099 },
        "arguments": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 4099 }
        },
        "outcome": { "enum": ["success", "blocked", "failed", "unknown"] },
        "errno": { "type": "string", "maxLength": 128 },
        "sensitive": { "type": "boolean" },
        "count": { "type": "integer", "minimum": 1, "maximum": 250000 },
        "id": { "type": "string", "pattern": "^event:sha256:[0-9a-f]{64}$" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "sourceSyscall": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": false
    }
  }
}
