{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:behaviorlock:schema:diff:3.0.0",
  "title": "BehaviorLock npm observed behavior diff",
  "type": "object",
  "required": ["schemaVersion", "kind", "tool", "phase", "baseline", "candidate", "baselineDigest", "candidateDigest", "added", "removed", "addedSequences", "removedSequences", "summary", "limitations"],
  "properties": {
    "schemaVersion": { "const": "3.0.0" },
    "kind": { "const": "npm.observation.diff" },
    "tool": { "$ref": "#/$defs/tool" },
    "phase": { "enum": ["lifecycle", "import", "external"] },
    "baseline": { "$ref": "#/$defs/subject" },
    "candidate": { "$ref": "#/$defs/subject" },
    "baselineDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "candidateDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "added": {
      "type": "array",
      "maxItems": 250000,
      "items": { "$ref": "#/$defs/change" }
    },
    "removed": {
      "type": "array",
      "maxItems": 250000,
      "items": { "$ref": "#/$defs/behavior" }
    },
    "addedSequences": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/sequence" }
    },
    "removedSequences": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/sequence" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "behaviorlock" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["ecosystem", "name", "version", "purl"],
      "properties": {
        "ecosystem": { "const": "npm" },
        "name": { "type": "string", "minLength": 1, "maxLength": 214 },
        "version": { "type": "string", "minLength": 5, "maxLength": 128 },
        "purl": { "type": "string", "pattern": "^pkg:npm/", "maxLength": 512 },
        "registryIntegrity": { "type": "string", "pattern": "^sha512-", "maxLength": 256 },
        "tarballSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "dependencyLockSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "object",
      "required": ["artifactSha256", "line", "lineSha256"],
      "properties": {
        "artifactSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "line": { "type": "integer", "minimum": 1 },
        "lineSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "behavior": {
      "type": "object",
      "required": ["type", "operation", "target", "outcome", "count", "id", "evidence", "sourceSyscall"],
      "properties": {
        "type": {
          "enum": [
            "filesystem.read",
            "filesystem.write",
            "filesystem.create",
            "filesystem.delete",
            "filesystem.rename",
            "filesystem.permission",
            "filesystem.truncate",
            "filesystem.descriptor_write",
            "filesystem.enumerate",
            "process.exec",
            "process.create",
            "process.memfd",
            "process.fileless_exec",
            "process.ptrace",
            "network.connect",
            "network.socket",
            "network.send",
            "network.dns",
            "network.bind",
            "network.listen",
            "network.accept",
            "environment.timing"
          ]
        },
        "operation": { "type": "string", "minLength": 1, "maxLength": 64 },
        "target": { "type": "string", "maxLength": 4099 },
        "arguments": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 4099 }
        },
        "outcome": { "enum": ["success", "blocked", "failed", "unknown"] },
        "errno": { "type": "string", "maxLength": 128 },
        "sensitive": { "type": "boolean" },
        "canaryIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^canary:[a-z0-9][a-z0-9-]{0,88}$" }
        },
        "count": { "type": "integer", "minimum": 1, "maximum": 250000 },
        "id": { "type": "string", "pattern": "^event:sha256:[0-9a-f]{64}$" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "runtime": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/runtimeContext" }
        },
        "sourceSyscall": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "runtimeContext": {
      "type": "object",
      "required": ["process", "attribution"],
      "properties": {
        "process": { "type": "string", "pattern": "^(root|[1-9][0-9]*)$", "maxLength": 10 },
        "parent": { "type": "string", "pattern": "^(root|[1-9][0-9]*)$", "maxLength": 10 },
        "descriptor": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 7 },
        "attribution": { "enum": ["direct", "descriptor", "unknown"] }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "required": ["reviewLevel", "ruleId", "reason", "behavior"],
      "properties": {
        "reviewLevel": { "enum": ["low", "medium", "high", "critical"] },
        "ruleId": { "type": "string", "pattern": "^BL[0-9]{3}$" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "behavior": { "$ref": "#/$defs/behavior" },
        "techniques": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/technique" }
        }
      },
      "additionalProperties": false
    },
    "technique": {
      "type": "object",
      "required": ["framework", "id", "relationship"],
      "properties": {
        "framework": { "const": "MITRE ATT&CK" },
        "id": { "type": "string", "pattern": "^T[0-9]{4}(?:\\.[0-9]{3})?$" },
        "relationship": { "const": "consistent with" }
      },
      "additionalProperties": false
    },
    "sequence": {
      "type": "object",
      "required": ["id", "scope", "behaviorIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^sequence:sha256:[0-9a-f]{64}$" },
        "scope": { "const": "process-lineage-observed-order" },
        "behaviorIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^event:sha256:[0-9a-f]{64}$" }
        },
        "canaryIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^canary:[a-z0-9][a-z0-9-]{0,88}$" }
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["reviewRequired", "highestReviewLevel"],
      "properties": {
        "reviewRequired": { "type": "boolean" },
        "highestReviewLevel": { "enum": ["none", "low", "medium", "high", "critical"] }
      },
      "additionalProperties": false
    }
  }
}
